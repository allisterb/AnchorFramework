// AgentCore conformance -- example-policies-temporal.md, "Enforce a cool-down".
// The forbid is AWS's, verbatim. The permit is OURS: without one every call is denied by default.
// No decision table; expected decisions come from AWS's prose (intent: "Prevent the same action
// from repeating within a minute of completing").

forbid (
    principal,
    action == AgentCore::Action::"InsuranceAPI___disburse_payment",
    resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:us-west-2:123456789012:gateway/insurance-gw-a1b2c3d4e5"
)
when temporal {
    formerly within 1m AgentCore::Action::"InsuranceAPI___disburse_payment"::response{
        eventResource: resource
    }
};

// ours
permit (
    principal,
    action == AgentCore::Action::"InsuranceAPI___disburse_payment",
    resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:us-west-2:123456789012:gateway/insurance-gw-a1b2c3d4e5"
);

//| target InsuranceAPI
//|
//| row aws-prose: a repeat within a minute of completing is denied; after the minute it is allowed
//| @0   request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  ALLOW
//| @1   response disburse_payment  { claimId: "CLM-1", amountCents: 100 } -> { claimId: "CLM-1", status: "PAID", amountCents: 100 }
//| @30  request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  DENY
//| @31  error    disburse_payment  { claimId: "CLM-1", amountCents: 100 }
//| @120 request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  ALLOW
