// AgentCore conformance -- example-policies-temporal.md, "Require a threshold number of events".
// The first statement is AWS's, verbatim. The second is OURS: the disbursements must complete,
// which needs a permit the example does not print. No decision table; expected decisions come from
// AWS's prose (intent: "deleted only after at least two disbursements completed against it";
// "Correlating input.claimId ... scopes the count to that claim").

permit (
    principal,
    action == AgentCore::Action::"InsuranceAPI___delete_claim",
    resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:us-west-2:123456789012:gateway/insurance-gw-a1b2c3d4e5"
)
when temporal {
    exists (n: Long).
        (count for (t: Timepoint).
            where (formerly within 5m (AgentCore::Action::"InsuranceAPI___disburse_payment"::response{ eventResource: resource, input.claimId: context.input.claimId } && tp(t)))) == n
        && n >= 2
};

// ours
permit (
    principal,
    action == AgentCore::Action::"InsuranceAPI___disburse_payment",
    resource == AgentCore::Gateway::"arn:aws:bedrock-agentcore:us-west-2:123456789012:gateway/insurance-gw-a1b2c3d4e5"
);

//| target InsuranceAPI
//|
//| row aws-prose: one completed disbursement against the claim
//| @0  request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  ALLOW ours
//| @1  response disburse_payment  { claimId: "CLM-1", amountCents: 100 } -> { claimId: "CLM-1", status: "PAID", amountCents: 100 }
//| @10 request  delete_claim      { claimId: "CLM-1" }  DENY
//|
//| row aws-prose: two completed disbursements against the claim
//| @0  request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  ALLOW ours
//| @1  response disburse_payment  { claimId: "CLM-1", amountCents: 100 } -> { claimId: "CLM-1", status: "PAID", amountCents: 100 }
//| @10 request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  ALLOW ours
//| @11 response disburse_payment  { claimId: "CLM-1", amountCents: 100 } -> { claimId: "CLM-1", status: "PAID", amountCents: 100 }
//| @20 request  delete_claim      { claimId: "CLM-1" }  ALLOW
//|
//| row aws-prose: two completed disbursements, but only one against this claim
//| @0  request  disburse_payment  { claimId: "CLM-1", amountCents: 100 }  ALLOW ours
//| @1  response disburse_payment  { claimId: "CLM-1", amountCents: 100 } -> { claimId: "CLM-1", status: "PAID", amountCents: 100 }
//| @10 request  disburse_payment  { claimId: "CLM-2", amountCents: 100 }  ALLOW ours
//| @11 response disburse_payment  { claimId: "CLM-2", amountCents: 100 } -> { claimId: "CLM-2", status: "PAID", amountCents: 100 }
//| @20 request  delete_claim      { claimId: "CLM-1" }  DENY
