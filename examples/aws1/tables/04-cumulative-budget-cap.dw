// The article's policy 4, VERBATIM from the published page (the policy text below the plain
// permits), against the article's OWN decision table for it, as `//|` rows. The table is AWS's
// statement of what the policy is for; a row marked `finding` is one where the policy as
// published does the opposite, and both Anchor and the Dogwood engine are held to that.
// Format and harness: tests/policies/agentcore/README.md. Timings are ours where the table's
// are qualitative; input values are ours where the table names none.
//
// The table counts TRADES; the policy sums `input.cost` over get_market_price REQUESTS. The
// table's DENY row is a finding when trades are made without quotes, and holds when each trade
// is quoted at its own cost first -- the last row, ours.

// ours: the plain permit the table assumes
permit (principal, action == AgentCore::Action::"get_market_price", resource);

// ---- policy 4, verbatim ----
permit (
    principal,
    action == AgentCore::Action::"execute_trade",
    resource
)
when temporal {
    exists (total: Long). ((sum amount for (amount: Long), (t: Timepoint). where (formerly within 24h (
        AgentCore::Action::"get_market_price"::request{input.cost: amount, eventResource: resource} && tp(t)))) == total && total < 60000
    )
};

//| target -
//|
//| row aws-table: prior $0, current $15,000, total $15,000 -- Allow
//| @0    request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 }  ALLOW
//|
//| row aws-table: prior $15,000, current $22,000, total $37,000 -- Allow
//| @0    request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 }  ALLOW
//| @1    response execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 } -> { }
//| @10   request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 22000 }  ALLOW
//|
//| row aws-table: prior $37,000, current $30,000, total $67,000 -- DENY. The policy sums the cost of get_market_price REQUESTS, not trades, so trades made without a quote are never counted
//| @0    request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 }  ALLOW
//| @1    response execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 } -> { }
//| @10   request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 22000 }  ALLOW
//| @11   response execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 22000 } -> { }
//| @20   request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 30000 }  DENY aws-table finding
//|
//| row ours: the same trades, each preceded by a quote requested at the trade's own cost -- the one reading under which the policy caps anything
//| @0   request  get_market_price  { stock_symbol: "A", cost: 15000 }  ALLOW
//| @1    request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 }  ALLOW
//| @2   response execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 15000 } -> { }
//| @10  request  get_market_price  { stock_symbol: "A", cost: 22000 }  ALLOW
//| @11   request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 22000 }  ALLOW
//| @12  response execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 22000 } -> { }
//| @20  request  get_market_price  { stock_symbol: "A", cost: 30000 }  ALLOW
//| @21   request  execute_trade  { profile_id: "client-1", portfolio_id: "port-8821", cost: 30000 }  DENY
